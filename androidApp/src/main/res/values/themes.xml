<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme" parent="Theme.AppCompat.DayNight.NoActionBar" />

    <style name="Theme.TikTokDownloader">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="android:statusBarColor">@color/light_surface</item>
        <item name="android:navigationBarColor">@color/navigation_bar</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
    </style>

    <style name="NoDisplayTheme" parent="Theme.TikTokDownloader">
        <item name="android:windowBackground">@null</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:windowNoDisplay">true</item>
    </style>
</resources>
